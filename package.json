{
  "name": "voxel-what-if-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node server/index.js",
    "start:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/scenarioEngine.test.js tests/environmentBuilders.test.js tests/videoExport.test.js tests/voxelPresenter.test.js tests/sceneTimeline.test.js tests/cameraDirector.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser-smoke.test.js tests/video-export-browser.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "playwright": "^1.64.1"
  }
}
